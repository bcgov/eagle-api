# typesense-sync local development environment
# Copy to .env and adjust as needed.
# .env is gitignored — never commit credentials.

# ── MongoDB ────────────────────────────────────────────────────────────────────
# For local Docker Compose (no auth needed — default if vars are unset):
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=epic
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_AUTHSOURCE=admin

# Use directConnection=true when connecting to a single-node replica set locally
# or when port-forwarding from OpenShift.
MONGODB_DIRECT=true

# ── Typesense ──────────────────────────────────────────────────────────────────
# For local Docker Compose:
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=local-dev-key

# ── To run against port-forwarded OpenShift dev services ──────────────────────
# 1. Port-forward MongoDB:
#      oc port-forward svc/eagle-api-mongodb 27017:27017 -n 6cdc9e-dev
#    Then set:
#      MONGODB_USERNAME=<from secret>
#      MONGODB_PASSWORD=<from secret>
#      MONGODB_DIRECT=true
#
# 2. Port-forward Typesense:
#      oc port-forward svc/typesense-typesense 8108:8108 -n 6cdc9e-dev
#    Then set:
#      TYPESENSE_API_KEY=<admin key from typesense secret>
